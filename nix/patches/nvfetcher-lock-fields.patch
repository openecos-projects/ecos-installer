+-- | Convert a sha256 'Checksum' in SRI form (@sha256-<base64>@) to lowercase hex.
+-- Returns 'Nothing' if the input is not a well-formed sha256 SRI.
+sriToHex :: Checksum -> Maybe Checksum
+sriToHex (coerce -> sri) = do
+  b64 <- T.stripPrefix "sha256-" sri
+  digest <- either (const Nothing) Just $ B64.decode $ T.encodeUtf8 b64
+  guard $ BS.length digest == 32
+  pure . coerce . T.pack $ concatMap (printf "%02x") $ BS.unpack digest
