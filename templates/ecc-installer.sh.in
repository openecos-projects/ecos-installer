#!/bin/sh
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
# shellcheck shell=dash
# shellcheck disable=SC2039
# Generated by ecos-release. Do not edit.

# This runs on Unix shells like bash/dash/ksh/zsh. It uses the common `local`
# extension. Note: Most shells limit `local` to 1 var per line, contra bash.
has_local() {
    # shellcheck disable=SC2034
    local _has_local
}

has_local 2>/dev/null || alias local=typeset

set -u

APP_NAME="ecc"
ECC_VERSION="@ECC_VERSION@"
ECC_TAG="@ECC_TAG@"
ECC_ASSET_NAME="@ECC_ASSET_NAME@"
ECC_SHA256="@ECC_SHA256@"
ECC_GITHUB_URL="@ECC_GITHUB_URL@"
ECC_CNB_URL="@ECC_CNB_URL@"
MIN_GLIBC_MAJOR="@MIN_GLIBC_MAJOR@"
MIN_GLIBC_MINOR="@MIN_GLIBC_MINOR@"
OSS_CAD_VERSION="@OSS_CAD_VERSION@"
OSS_CAD_ASSET_NAME="@OSS_CAD_ASSET_NAME@"
OSS_CAD_SHA256="@OSS_CAD_SHA256@"
OSS_CAD_URL="@OSS_CAD_URL@"
OSS_CAD_CNB_URL="@OSS_CAD_CNB_URL@"
SIZER_VERSION="@SIZER_VERSION@"
SIZER_ASSET_NAME="@SIZER_ASSET_NAME@"
SIZER_SHA256="@SIZER_SHA256@"
SIZER_URL="@SIZER_URL@"
SIZER_CNB_URL="@SIZER_CNB_URL@"
SIZER_CNB_SHA256="@SIZER_CNB_SHA256@"
PDK_NAME="@PDK_NAME@"
PDK_VERSION="@PDK_VERSION@"
PDK_BASE_ASSET_NAME="@PDK_BASE_ASSET_NAME@"
PDK_BASE_SHA256="@PDK_BASE_SHA256@"
PDK_BASE_URL="@PDK_BASE_URL@"
PDK_BASE_CNB_URL="@PDK_BASE_CNB_URL@"
PDK_BASE_CNB_SHA256="@PDK_BASE_CNB_SHA256@"
PDK_TECH_LEF="@PDK_TECH_LEF@"
WRAPPER_MARKER="# ecos-release-wrapper-v1"

PRINT_VERBOSE=0
PRINT_QUIET=0
WITH_TOOLCHAIN=0
DOWNLOAD_SOURCE="auto"

DATA_ROOT=""
BIN_DIR=""
CACHE_ROOT=""
CONFIG_ROOT=""
CACHE_DOWNLOADS=""
LOCK_DIR=""
LOCK_OWNED=0
PARTIAL_FILE=""
STAGING_DIR=""

usage() {
    cat <<EOF
ecc-installer.sh

The installer for ECC ${ECC_VERSION}

USAGE:
    ecc-installer.sh [OPTIONS]

OPTIONS:
    -h, --help
            Print help information

    -v, --verbose
            Enable verbose output

    -q, --quiet
            Disable progress output

        --with-toolchain
            Install OSS CAD Suite, the ICS55 PDK, and ecc-sizer

        --download-source auto|github|cnb
            Select download source for mirrored assets (default: auto)

ENVIRONMENT:
    ECC_WITH_TOOLCHAIN=0|1
    ECC_DOWNLOAD_SOURCE=auto|github|cnb
    ECC_INSTALL_DIR=/absolute/path/to/ecc-data
    ECC_GITHUB_BASE_URL=https://ghfast.top/https://github.com
            Replace the https://github.com prefix of GitHub asset URLs.
            CNB URLs are unchanged.
EOF
}

say() {
    if [ "$PRINT_QUIET" = 0 ]; then
        printf '%s\n' "$1" >&2
    fi
}

say_verbose() {
    if [ "$PRINT_VERBOSE" = 1 ]; then
        printf '%s\n' "$1" >&2
    fi
}

warn() {
    printf 'WARN: %s\n' "$1" >&2
}

err() {
    printf 'ERROR: %s\n' "$1" >&2
    exit 1
}

need_cmd() {
    if ! check_cmd "$1"; then
        err "need '$1' (command not found)"
    fi
}

check_cmd() {
    command -v "$1" >/dev/null 2>&1
}

ensure() {
    if ! "$@"; then
        err "command failed: $*"
    fi
}

shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

json_escape() {
    printf '%s' "$1" | awk '
    BEGIN { ORS="" }
    {
        for (i = 1; i <= length($0); i++) {
            c = substr($0, i, 1)
            if (c == "\\") printf "\\\\"
            else if (c == "\"") printf "\\\""
            else if (c == "\n") printf "\\n"
            else if (c == "\r") printf "\\r"
            else if (c == "\t") printf "\\t"
            else printf "%s", c
        }
    }'
}

path_has_control() {
    printf '%s' "$1" | awk '{
        for (i = 1; i <= length($0); i++) {
            if (substr($0, i, 1) ~ /[[:cntrl:]]/) exit 1
        }
    }'
}

validate_abs_path() {
    local _name="$1"
    local _path="$2"
    case "$_path" in
        /*) ;;
        *)
            err "$_name must be an absolute path: $_path"
            ;;
    esac
    if ! path_has_control "$_path"; then
        err "$_name contains control characters: $_path"
    fi
}

physical_dir() {
    (CDPATH= cd -P -- "$1" && pwd -P)
}

parse_bool_env() {
    local _name="$1"
    local _val="$2"
    case "$_val" in
        0|1) ;;
        *)
            err "$_name must be 0 or 1"
            ;;
    esac
}

cleanup() {
    _status=$?
    if [ -n "${PARTIAL_FILE:-}" ] && [ -e "$PARTIAL_FILE" ]; then
        rm -f "$PARTIAL_FILE" 2>/dev/null || true
    fi
    if [ -n "${STAGING_DIR:-}" ] && [ -d "$STAGING_DIR" ]; then
        rm -rf "$STAGING_DIR" 2>/dev/null || true
    fi
    if [ "${LOCK_OWNED:-0}" = 1 ] && [ -n "${LOCK_DIR:-}" ]; then
        rmdir "$LOCK_DIR" 2>/dev/null || true
    fi
    exit "$_status"
}

trap cleanup EXIT INT HUP TERM

parse_args() {
    if [ -n "${ECC_WITH_TOOLCHAIN:-}" ]; then
        parse_bool_env ECC_WITH_TOOLCHAIN "$ECC_WITH_TOOLCHAIN"
        WITH_TOOLCHAIN="$ECC_WITH_TOOLCHAIN"
    fi
    if [ -n "${ECC_DOWNLOAD_SOURCE:-}" ]; then
        DOWNLOAD_SOURCE="$ECC_DOWNLOAD_SOURCE"
    fi

    while [ "$#" -gt 0 ]; do
        arg="$1"
        case "$arg" in
            -h|--help)
                usage
                trap - EXIT INT HUP TERM
                exit 0
                ;;
            -v|--verbose)
                PRINT_VERBOSE=1
                ;;
            -q|--quiet)
                PRINT_QUIET=1
                ;;
            --with-toolchain)
                WITH_TOOLCHAIN=1
                ;;
            --download-source)
                if [ -z "${2:-}" ]; then
                    err "--download-source requires a value"
                fi
                DOWNLOAD_SOURCE="$2"
                shift
                ;;
            --download-source=*)
                DOWNLOAD_SOURCE="${arg#--download-source=}"
                ;;
            --)
                shift
                break
                ;;
            -*)
                err "unknown option $arg"
                ;;
            *)
                err "unexpected argument $arg"
                ;;
        esac
        shift
    done

    if [ "$#" -gt 0 ]; then
        err "unexpected argument $1"
    fi
    if [ "$PRINT_VERBOSE" = 1 ] && [ "$PRINT_QUIET" = 1 ]; then
        err "conflicting options: --quiet and --verbose"
    fi
    case "$DOWNLOAD_SOURCE" in
        auto|github|cnb) ;;
        *)
            err "invalid --download-source $DOWNLOAD_SOURCE (expected auto, github, or cnb)"
            ;;
    esac
}

need_base_cmds() {
    need_cmd curl
    need_cmd uname
    need_cmd mktemp
    need_cmd mkdir
    need_cmd mv
    need_cmd rm
    need_cmd tar
    need_cmd sha256sum
    need_cmd chmod
    need_cmd grep
    need_cmd sed
    need_cmd awk
    need_cmd head
    need_cmd tail
    need_cmd find
    need_cmd cat
    need_cmd ldd
}

preflight_curl() {
    _help="$(curl --help all 2>/dev/null || curl --help 2>/dev/null || true)"
    if [ -z "$_help" ]; then
        err "unable to inspect curl options"
    fi
    for _opt in connect-timeout retry retry-delay retry-max-time speed-limit speed-time; do
        if ! printf '%s\n' "$_help" | grep -q -- "$_opt"; then
            err "curl does not support --$_opt"
        fi
    done
}

preflight_tar() {
    _ver="$(tar --version 2>&1 | head -n 1)"
    case "$_ver" in
        *GNU*) ;;
        *)
            err "need GNU tar with owner and permission restoration disabled, got: $_ver"
            ;;
    esac
}

get_current_exe() {
    if [ -L /proc/self/exe ] || [ -e /proc/self/exe ]; then
        printf '%s\n' /proc/self/exe
        return 0
    fi
    err "unable to find /proc/self/exe for userland bitness detection"
}

get_bitness() {
    local _current_exe="$1"
    local _head
    _head="$(head -c 5 "$_current_exe")"
    if [ "$_head" = "$(printf '\177ELF\001')" ]; then
        printf '%s\n' 32
    elif [ "$_head" = "$(printf '\177ELF\002')" ]; then
        printf '%s\n' 64
    else
        err "unknown platform bitness"
    fi
}

unsupported_platform() {
    err "unsupported platform: os=${1} cpu=${2} bitness=${3} libc=${4} libc_version=${5} (need linux x86_64 glibc >= ${MIN_GLIBC_MAJOR}.${MIN_GLIBC_MINOR})"
}

detect_platform() {
    local _os
    local _cpu
    local _bitness
    local _libc
    local _libc_version
    local _ldd
    local _major
    local _minor
    _os="$(uname -s)"
    _cpu="$(uname -m)"
    _bitness="unknown"
    _libc="unknown"
    _libc_version="unknown"
    case "$_cpu" in
        x86_64|x86-64|x64|amd64)
            _cpu="x86_64"
            ;;
    esac
    if [ "$_os" != Linux ]; then
        unsupported_platform "$_os" "$_cpu" "$_bitness" "$_libc" "$_libc_version"
    fi
    _bitness="$(get_bitness "$(get_current_exe)")"
    if [ "$_bitness" != 64 ]; then
        unsupported_platform "$_os" "$_cpu" "$_bitness" "$_libc" "$_libc_version"
    fi
    if [ "$_cpu" != x86_64 ]; then
        unsupported_platform "$_os" "$_cpu" "$_bitness" "$_libc" "$_libc_version"
    fi
    _ldd="$(ldd --version 2>&1 || true)"
    case "$_ldd" in
        *musl*)
            _libc="musl"
            unsupported_platform "$_os" "$_cpu" "$_bitness" "$_libc" "$_libc_version"
            ;;
    esac
    _libc="glibc"
    _libc_version="$(printf '%s\n' "$_ldd" | awk -F' ' '{ if (FNR<=1) print $NF }')"
    _major="$(printf '%s\n' "$_libc_version" | awk -F. '{ print $1 }')"
    _minor="$(printf '%s\n' "$_libc_version" | awk -F. '{ print $2 }')"
    if [ -z "$_major" ] || [ -z "$_minor" ]; then
        unsupported_platform "$_os" "$_cpu" "$_bitness" "$_libc" "$_libc_version"
    fi
    if [ "$_major" -gt "$MIN_GLIBC_MAJOR" ] || { [ "$_major" -eq "$MIN_GLIBC_MAJOR" ] && [ "$_minor" -ge "$MIN_GLIBC_MINOR" ]; }; then
        say_verbose "platform linux x86_64 glibc ${_libc_version}"
        return 0
    fi
    unsupported_platform "$_os" "$_cpu" "$_bitness" "$_libc" "$_libc_version"
}

resolve_roots() {
    if [ -n "${ECC_INSTALL_DIR:-}" ]; then
        validate_abs_path ECC_INSTALL_DIR "$ECC_INSTALL_DIR"
        DATA_ROOT="$ECC_INSTALL_DIR"
    elif [ -n "${XDG_DATA_HOME:-}" ]; then
        validate_abs_path XDG_DATA_HOME "$XDG_DATA_HOME"
        DATA_ROOT="${XDG_DATA_HOME}/ecc"
    elif [ -n "${HOME:-}" ]; then
        DATA_ROOT="${HOME}/.local/share/ecc"
    else
        err "HOME is unset; set ECC_INSTALL_DIR or XDG_DATA_HOME"
    fi

    if [ -n "${XDG_BIN_HOME:-}" ]; then
        validate_abs_path XDG_BIN_HOME "$XDG_BIN_HOME"
        BIN_DIR="$XDG_BIN_HOME"
    elif [ -n "${HOME:-}" ]; then
        BIN_DIR="${HOME}/.local/bin"
    else
        err "HOME is unset; set XDG_BIN_HOME"
    fi

    if [ -n "${XDG_CACHE_HOME:-}" ]; then
        validate_abs_path XDG_CACHE_HOME "$XDG_CACHE_HOME"
        CACHE_ROOT="${XDG_CACHE_HOME}/ecc"
    elif [ -n "${HOME:-}" ]; then
        CACHE_ROOT="${HOME}/.cache/ecc"
    else
        err "HOME is unset; set XDG_CACHE_HOME"
    fi

    if [ -n "${XDG_CONFIG_HOME:-}" ]; then
        validate_abs_path XDG_CONFIG_HOME "$XDG_CONFIG_HOME"
        CONFIG_ROOT="${XDG_CONFIG_HOME}/ecc"
    elif [ -n "${HOME:-}" ]; then
        CONFIG_ROOT="${HOME}/.config/ecc"
    else
        err "HOME is unset; set XDG_CONFIG_HOME"
    fi

    ensure mkdir -p "$DATA_ROOT" "$BIN_DIR" "$CACHE_ROOT" "$CONFIG_ROOT"
    DATA_ROOT="$(physical_dir "$DATA_ROOT")"
    BIN_DIR="$(physical_dir "$BIN_DIR")"
    CACHE_ROOT="$(physical_dir "$CACHE_ROOT")"
    CONFIG_ROOT="$(physical_dir "$CONFIG_ROOT")"
    CACHE_DOWNLOADS="${CACHE_ROOT}/downloads"
    ensure mkdir -p "$CACHE_DOWNLOADS"
    LOCK_DIR="${DATA_ROOT}/.ecc-install-lock"
}

wrapper_is_owned() {
    local _path="$1"
    local _line1
    local _line2
    if [ ! -f "$_path" ]; then
        return 1
    fi
    _line1="$(head -n 1 "$_path")"
    _line2="$(head -n 2 "$_path" | tail -n 1)"
    [ "$_line1" = "#!/bin/sh" ] && [ "$_line2" = "$WRAPPER_MARKER" ]
}

check_wrapper_collision() {
    local _wrapper="${BIN_DIR}/ecc"
    if [ ! -e "$_wrapper" ]; then
        return 0
    fi
    if wrapper_is_owned "$_wrapper"; then
        return 0
    fi
    err "refusing to overwrite unowned binary at ${_wrapper}"
}

cache_path_for() {
    local _sha="$1"
    local _name="$2"
    case "$_name" in
        *.tar.bz2)
            printf '%s\n' "${CACHE_DOWNLOADS}/${_sha}.tar.bz2"
            ;;
        *)
            printf '%s\n' "${CACHE_DOWNLOADS}/${_sha}.tar.gz"
            ;;
    esac
}

verify_sha256() {
    local _file="$1"
    local _want="$2"
    local _got
    _got="$(sha256sum "$_file" | awk '{ print $1 }')"
    if [ "$_got" = "$_want" ]; then
        return 0
    fi
    printf 'ERROR: checksum mismatch for %s\n' "$_file" >&2
    printf 'ERROR:   want: %s\n' "$_want" >&2
    printf 'ERROR:   got:  %s\n' "$_got" >&2
    return 1
}

curl_fetch() {
    local _url="$1"
    local _dest="$2"
    if [ "$PRINT_QUIET" = 1 ]; then
        curl -sS -fL \
            --connect-timeout 10 \
            --retry 2 \
            --retry-delay 2 \
            --retry-max-time 60 \
            --speed-limit 1024 \
            --speed-time 30 \
            -o "$_dest" \
            "$_url"
    else
        curl -fL \
            --connect-timeout 10 \
            --retry 2 \
            --retry-delay 2 \
            --retry-max-time 60 \
            --speed-limit 1024 \
            --speed-time 30 \
            -o "$_dest" \
            "$_url"
    fi
}

try_download_verified() {
    local _sha="$1"
    local _name="$2"
    shift 2
    local _cache
    local _url
    local _part
    _cache="$(cache_path_for "$_sha" "$_name")"
    if [ -f "$_cache" ]; then
        if verify_sha256 "$_cache" "$_sha"; then
            say_verbose "reusing cache $_cache"
            printf '%s\n' "$_cache"
            return 0
        fi
        warn "replacing invalid cache entry $_cache"
        rm -f "$_cache"
    fi
    for _url in "$@"; do
        [ -n "$_url" ] && [ "$_url" != "-" ] || continue
        say "downloading $_name"
        say_verbose "  from $_url"
        _part="$(mktemp "${CACHE_DOWNLOADS}/partial.XXXXXX")"
        PARTIAL_FILE="$_part"
        if curl_fetch "$_url" "$_part"; then
            if verify_sha256 "$_part" "$_sha"; then
                if [ -f "$_cache" ] && verify_sha256 "$_cache" "$_sha"; then
                    rm -f "$_part"
                    PARTIAL_FILE=""
                    printf '%s\n' "$_cache"
                    return 0
                fi
                rm -f "$_cache"
                ensure mv "$_part" "$_cache"
                PARTIAL_FILE=""
                printf '%s\n' "$_cache"
                return 0
            fi
            rm -f "$_part"
            PARTIAL_FILE=""
            continue
        fi
        rm -f "$_part"
        PARTIAL_FILE=""
        say "failed to download $_url"
    done
    return 1
}

download_verified() {
    local _name="$2"
    if try_download_verified "$@"; then
        return 0
    fi
    err "failed to download $_name"
}

rewrite_github_url() {
    local _url="$1"
    local _base
    case "$_url" in
        https://github.com/*)
            if [ -n "${ECC_GITHUB_BASE_URL:-}" ]; then
                _base="${ECC_GITHUB_BASE_URL%/}"
                printf '%s\n' "${_base}${_url#https://github.com}"
                return 0
            fi
            ;;
    esac
    printf '%s\n' "$_url"
}

download_by_source() {
    local _sha="$1"
    local _name="$2"
    local _github="$3"
    local _cnb="$4"
    local _cnb_sha="${5:-}"
    _github="$(rewrite_github_url "$_github")"
    if [ -z "$_cnb_sha" ]; then
        _cnb_sha="$_sha"
    fi
    case "$DOWNLOAD_SOURCE" in
        auto)
            if [ "$_cnb_sha" = "$_sha" ]; then
                if [ -n "$_cnb" ] && [ "$_cnb" != "-" ]; then
                    download_verified "$_sha" "$_name" "$_github" "$_cnb"
                else
                    download_verified "$_sha" "$_name" "$_github"
                fi
            else
                if try_download_verified "$_sha" "$_name" "$_github"; then
                    return 0
                fi
                if [ -n "$_cnb" ] && [ "$_cnb" != "-" ]; then
                    download_verified "$_cnb_sha" "$_name" "$_cnb"
                else
                    err "failed to download $_name"
                fi
            fi
            ;;
        github)
            download_verified "$_sha" "$_name" "$_github"
            ;;
        cnb)
            if [ -n "$_cnb" ] && [ "$_cnb" != "-" ]; then
                download_verified "$_cnb_sha" "$_name" "$_cnb"
            else
                say "no CNB URL for $_name; downloading from GitHub"
                download_verified "$_sha" "$_name" "$_github"
            fi
            ;;
    esac
}

download_ecc() {
    download_by_source "$ECC_SHA256" "$ECC_ASSET_NAME" "$ECC_GITHUB_URL" "$ECC_CNB_URL"
}

acquire_lock() {
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        LOCK_OWNED=1
        return 0
    fi
    err "installer lock already exists at ${LOCK_DIR}; confirm that no installer is running, then remove it manually and retry"
}

new_staging() {
    if [ -n "${STAGING_DIR:-}" ] && [ -d "$STAGING_DIR" ]; then
        rm -rf "$STAGING_DIR"
    fi
    STAGING_DIR="$(mktemp -d "${DATA_ROOT}/.ecc-staging.XXXXXX")"
    printf '%s\n' "$STAGING_DIR"
}

clear_staging() {
    STAGING_DIR=""
}

extract_archive() {
    local _archive="$1"
    local _dest="$2"
    ensure mkdir -p "$_dest"
    case "$_archive" in
        *.tar.bz2)
            if ! tar --no-same-owner --no-same-permissions -xjf "$_archive" -C "$_dest"; then
                err "failed to extract $_archive"
            fi
            ;;
        *)
            if ! tar --no-same-owner --no-same-permissions -xf "$_archive" -C "$_dest"; then
                err "failed to extract $_archive"
            fi
            ;;
    esac
    reject_unexpected_types "$_dest"
}

reject_unexpected_types() {
    local _dir="$1"
    local _unexpected
    _unexpected="$(find "$_dir" \( ! -type f ! -type d ! -type l \) -print)"
    if [ -n "$_unexpected" ]; then
        err "unexpected filesystem object types after extraction under $_dir"
    fi
}

find_ecc_root() {
    local _staging="$1"
    local _cand
    if [ -e "$_staging/ecc" ] && [ -d "$_staging/_internal" ]; then
        printf '%s\n' "$_staging"
        return 0
    fi
    for _cand in "$_staging"/*; do
        if [ -e "$_cand/ecc" ] && [ -d "$_cand/_internal" ]; then
            printf '%s\n' "$_cand"
            return 0
        fi
    done
    return 1
}

find_oss_root() {
    local _staging="$1"
    local _cand
    if [ -e "$_staging/bin/yosys" ]; then
        printf '%s\n' "$_staging"
        return 0
    fi
    if [ -e "$_staging/oss-cad-suite/bin/yosys" ]; then
        printf '%s\n' "$_staging/oss-cad-suite"
        return 0
    fi
    for _cand in "$_staging"/*; do
        if [ -e "$_cand/bin/yosys" ]; then
            printf '%s\n' "$_cand"
            return 0
        fi
    done
    return 1
}

find_sizer_root() {
    local _staging="$1"
    local _cand
    if [ -e "$_staging/bin/Sizer" ] && [ -e "$_staging/libexec/Sizer" ]; then
        printf '%s\n' "$_staging"
        return 0
    fi
    for _cand in "$_staging"/*; do
        if [ -e "$_cand/bin/Sizer" ] && [ -e "$_cand/libexec/Sizer" ]; then
            printf '%s\n' "$_cand"
            return 0
        fi
    done
    return 1
}

find_pdk_root() {
    local _staging="$1"
    local _cand
    if [ -d "$_staging/prtech" ]; then
        printf '%s\n' "$_staging"
        return 0
    fi
    for _cand in "$_staging"/*; do
        if [ -d "$_cand/prtech" ]; then
            printf '%s\n' "$_cand"
            return 0
        fi
    done
    return 1
}

promote_dir() {
    local _src="$1"
    local _dest="$2"
    local _parent
    _parent="$(printf '%s\n' "$_dest" | sed 's,/[^/]*$,,')"
    ensure mkdir -p "$_parent"
    if ! mv "$_src" "$_dest"; then
        err "failed to promote $_src to $_dest"
    fi
}

validate_ecc_dir() {
    local _dir="$1"
    if [ ! -x "$_dir/ecc" ] || [ ! -d "$_dir/_internal" ]; then
        return 1
    fi
    if [ ! -x "$_dir/_internal/torch/bin/torch_shm_manager" ]; then
        return 1
    fi
    if ! "$_dir/ecc" --version >/dev/null 2>&1; then
        return 1
    fi
    if ! "$_dir/ecc" version --json >/dev/null 2>&1; then
        return 1
    fi
    return 0
}

run_without_loader_env() {
    (
        unset LD_LIBRARY_PATH
        unset LD_PRELOAD
        "$@"
    )
}

validate_oss_dir() {
    local _root="$1"
    local _yosys
    local _out
    _yosys="${_root}/bin/yosys"
    if [ ! -x "$_yosys" ]; then
        return 1
    fi
    if [ ! -d "${_root}/share/yosys/plugins" ]; then
        return 1
    fi
    if ! run_without_loader_env "$_yosys" --version >/dev/null 2>&1; then
        return 1
    fi
    if _out="$(run_without_loader_env "$_yosys" -Q -T -p "help read_slang" 2>&1)"; then
        if ! printf '%s\n' "$_out" | grep -q "No such command"; then
            return 0
        fi
    fi
    if run_without_loader_env "$_yosys" -Q -T -p "plugin -i slang" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

validate_sizer_dir() {
    local _dir="$1"
    local _out
    if [ ! -x "$_dir/bin/Sizer" ] || [ ! -x "$_dir/libexec/Sizer" ]; then
        return 1
    fi
    if [ ! -f "$_dir/lib/ld-linux-x86-64.so.2" ]; then
        return 1
    fi
    _out="$(run_without_loader_env "$_dir/bin/Sizer" --version 2>&1)"
    printf '%s\n' "$_out" | grep -q "v${SIZER_VERSION}"
}

validate_pdk_dir() {
    local _root="$1"
    local _rel
    if [ ! -s "${_root}/${PDK_TECH_LEF}" ]; then
        return 1
    fi
    while IFS= read -r _rel || [ -n "${_rel:-}" ]; do
        [ -n "$_rel" ] || continue
        if [ ! -s "${_root}/${_rel}" ]; then
            return 1
        fi
    done <<'PDK_CELL_LEFS'
@PDK_CELL_LEFS@
PDK_CELL_LEFS
    while IFS= read -r _rel || [ -n "${_rel:-}" ]; do
        [ -n "$_rel" ] || continue
        if [ ! -s "${_root}/${_rel}" ]; then
            return 1
        fi
    done <<'PDK_LIBERTY_FILES'
@PDK_LIBERTY_FILES@
PDK_LIBERTY_FILES
    return 0
}

install_ecc_bundle() {
    local _archive="$1"
    local _dest="${DATA_ROOT}/${ECC_TAG}"
    local _staging
    local _root
    if [ -e "$_dest" ]; then
        if [ -d "$_dest" ] && validate_ecc_dir "$_dest"; then
            say "reusing existing ECC ${ECC_TAG}"
            return 0
        fi
        err "existing ECC directory ${_dest} is incomplete or failed validation; move it aside before reinstalling"
    fi
    _staging="$(new_staging)"
    extract_archive "$_archive" "$_staging"
    if ! _root="$(find_ecc_root "$_staging")"; then
        err "ECC archive is missing the expected ecc and _internal layout"
    fi
    if ! validate_ecc_dir "$_root"; then
        err "ECC smoke tests failed for extracted bundle"
    fi
    if [ "$_root" = "$_staging" ]; then
        promote_dir "$_staging" "$_dest"
        clear_staging
    else
        promote_dir "$_root" "$_dest"
        rm -rf "$_staging"
        clear_staging
    fi
}

install_oss_cad() {
    local _archive="$1"
    local _dest="${DATA_ROOT}/tools/oss-cad-suite/${OSS_CAD_VERSION}"
    local _staging
    local _root
    if [ -e "$_dest" ]; then
        if [ -d "$_dest" ] && validate_oss_dir "$_dest"; then
            say "reusing existing OSS CAD Suite ${OSS_CAD_VERSION}"
            printf '%s\n' "$_dest"
            return 0
        fi
        err "existing OSS CAD Suite directory ${_dest} is invalid and will not be replaced in place"
    fi
    _staging="$(new_staging)"
    extract_archive "$_archive" "$_staging"
    if ! _root="$(find_oss_root "$_staging")"; then
        err "OSS CAD Suite archive is missing bin/yosys"
    fi
    if ! validate_oss_dir "$_root"; then
        err "OSS CAD Suite validation failed"
    fi
    if [ "$_root" = "$_staging" ]; then
        promote_dir "$_staging" "$_dest"
        clear_staging
    else
        promote_dir "$_root" "$_dest"
        rm -rf "$_staging"
        clear_staging
    fi
    printf '%s\n' "$_dest"
}

install_sizer() {
    local _archive="$1"
    local _dest="${DATA_ROOT}/tools/ecc-sizer/${SIZER_VERSION}"
    local _staging
    local _root
    if [ -e "$_dest" ]; then
        if [ -d "$_dest" ] && validate_sizer_dir "$_dest"; then
            say "reusing existing ecc-sizer ${SIZER_VERSION}"
            printf '%s\n' "$_dest"
            return 0
        fi
        err "existing ecc-sizer directory ${_dest} is invalid and will not be replaced in place"
    fi
    _staging="$(new_staging)"
    extract_archive "$_archive" "$_staging"
    if ! _root="$(find_sizer_root "$_staging")"; then
        err "ecc-sizer archive is missing the expected bin/Sizer layout"
    fi
    if ! validate_sizer_dir "$_root"; then
        err "ecc-sizer validation failed"
    fi
    if [ "$_root" = "$_staging" ]; then
        promote_dir "$_staging" "$_dest"
        clear_staging
    else
        promote_dir "$_root" "$_dest"
        rm -rf "$_staging"
        clear_staging
    fi
    printf '%s\n' "$_dest"
}

prefetch_pdk_supplementals() {
    local _name
    local _sha
    local _github
    local _cnb
    local _dest
    while IFS="$(printf '\t')" read -r _name _sha _github _cnb _dest || [ -n "${_name:-}" ]; do
        [ -n "$_name" ] || continue
        download_by_source "$_sha" "$_name" "$_github" "$_cnb" >/dev/null
    done <<'PDK_ASSETS'
@PDK_ASSET_TABLE@
PDK_ASSETS
}

extract_pdk_supplementals() {
    local _root="$1"
    local _name
    local _sha
    local _github
    local _cnb
    local _dest
    local _archive
    local _target
    while IFS="$(printf '\t')" read -r _name _sha _github _cnb _dest || [ -n "${_name:-}" ]; do
        [ -n "$_name" ] || continue
        _archive="$(download_by_source "$_sha" "$_name" "$_github" "$_cnb")"
        _target="${_root}/${_dest}"
        ensure mkdir -p "$_target"
        extract_archive "$_archive" "$_target"
    done <<'PDK_ASSETS'
@PDK_ASSET_TABLE@
PDK_ASSETS
}

install_pdk() {
    local _archive="$1"
    local _dest="${DATA_ROOT}/pdks/${PDK_NAME}/${PDK_VERSION}"
    local _staging
    local _root
    if [ -e "$_dest" ]; then
        if [ -d "$_dest" ] && validate_pdk_dir "$_dest"; then
            say "reusing existing ICS55 PDK ${PDK_VERSION}"
            printf '%s\n' "$_dest"
            return 0
        fi
        err "existing ICS55 PDK directory ${_dest} is invalid and will not be replaced in place"
    fi
    _staging="$(new_staging)"
    extract_archive "$_archive" "$_staging"
    if ! _root="$(find_pdk_root "$_staging")"; then
        err "ICS55 PDK base archive is missing the expected prtech layout"
    fi
    extract_pdk_supplementals "$_root"
    if ! validate_pdk_dir "$_root"; then
        err "ICS55 PDK validation failed"
    fi
    if [ "$_root" = "$_staging" ]; then
        promote_dir "$_staging" "$_dest"
        clear_staging
    else
        promote_dir "$_root" "$_dest"
        rm -rf "$_staging"
        clear_staging
    fi
    printf '%s\n' "$_dest"
}

select_existing_toolchain() {
    local _oss="${DATA_ROOT}/tools/oss-cad-suite/${OSS_CAD_VERSION}"
    local _pdk="${DATA_ROOT}/pdks/${PDK_NAME}/${PDK_VERSION}"
    if [ -d "$_oss" ] && [ -d "$_pdk" ] && validate_oss_dir "$_oss" && validate_pdk_dir "$_pdk"; then
        OSS_ROOT="$_oss"
        PDK_ROOT="$_pdk"
        return 0
    fi
    OSS_ROOT=""
    PDK_ROOT=""
    return 1
}

write_wrapper() {
    local _oss_root="$1"
    local _pdk_root="$2"
    local _tmp
    local _dest="${BIN_DIR}/ecc"
    _tmp="$(mktemp "${BIN_DIR}/ecc.XXXXXX")"
    {
        printf '%s\n' '#!/bin/sh'
        printf '%s\n' "$WRAPPER_MARKER"
        printf 'ECC_DATA_ROOT=%s\n' "$(shell_quote "$DATA_ROOT")"
        printf 'ECC_VERSION=%s\n' "$(shell_quote "$ECC_TAG")"
        if [ -n "$_oss_root" ] && [ -n "$_pdk_root" ]; then
            printf 'export CHIPCOMPILER_OSS_CAD_DIR=%s\n' "$(shell_quote "$_oss_root")"
            printf 'export CHIPCOMPILER_ICS55_PDK_ROOT=%s\n' "$(shell_quote "$_pdk_root")"
        fi
        printf '%s\n' 'exec "$ECC_DATA_ROOT/$ECC_VERSION/ecc" "$@"'
    } > "$_tmp"
    ensure chmod u+x "$_tmp"
    if ! sh -n "$_tmp"; then
        rm -f "$_tmp"
        err "generated wrapper failed syntax check"
    fi
    ensure mv "$_tmp" "$_dest"
}

write_receipt() {
    local _tmp
    local _dest="${CONFIG_ROOT}/ecc-receipt.json"
    _tmp="${CONFIG_ROOT}/ecc-receipt.json.tmp.$$"
    if ! printf '%s\n' "{\"binaries\":[\"ecc\"],\"data_root\":\"$(json_escape "$DATA_ROOT")\",\"install_prefix\":\"$(json_escape "$BIN_DIR")\",\"provider\":{\"format\":1,\"name\":\"ecos-release\"},\"version\":\"$(json_escape "$ECC_VERSION")\"}" > "$_tmp"; then
        rm -f "$_tmp"
        warn "failed to write install receipt at ${_dest}"
        return 0
    fi
    if ! mv "$_tmp" "$_dest"; then
        rm -f "$_tmp"
        warn "failed to write install receipt at ${_dest}"
        return 0
    fi
}

print_path_guidance() {
    local _shell_base
    local _resolved
    _shell_base="$(printf '%s\n' "${SHELL:-sh}" | sed 's,.*/,,')"
    case ":${PATH}:" in
        *:"${BIN_DIR}":*) ;;
        *)
            say "The ECC wrapper was installed to ${BIN_DIR}, which is not in PATH."
            if [ "$_shell_base" = fish ]; then
                say "Add it with:"
                say "    fish_add_path ${BIN_DIR}"
            else
                say "Add it with:"
                say "    export PATH=\"${BIN_DIR}:\$PATH\""
            fi
            ;;
    esac
    _resolved="$(command -v ecc 2>/dev/null || true)"
    if [ -n "$_resolved" ] && [ "$_resolved" != "${BIN_DIR}/ecc" ]; then
        warn "ecc is shadowed by ${_resolved}"
    fi
}

main() {
    parse_args "$@"
    need_base_cmds
    preflight_curl
    preflight_tar
    detect_platform
    resolve_roots
    check_wrapper_collision
    if [ "$WITH_TOOLCHAIN" = 1 ]; then
        need_cmd bzip2
    fi

    ECC_ARCHIVE="$(download_ecc)"
    OSS_ARCHIVE=""
    SIZER_ARCHIVE=""
    PDK_ARCHIVE=""
    if [ "$WITH_TOOLCHAIN" = 1 ]; then
        OSS_ARCHIVE="$(download_by_source "$OSS_CAD_SHA256" "$OSS_CAD_ASSET_NAME" "$OSS_CAD_URL" "$OSS_CAD_CNB_URL")"
        SIZER_ARCHIVE="$(download_by_source "$SIZER_SHA256" "$SIZER_ASSET_NAME" "$SIZER_URL" "$SIZER_CNB_URL" "$SIZER_CNB_SHA256")"
        PDK_ARCHIVE="$(download_by_source "$PDK_BASE_SHA256" "$PDK_BASE_ASSET_NAME" "$PDK_BASE_URL" "$PDK_BASE_CNB_URL" "$PDK_BASE_CNB_SHA256")"
        prefetch_pdk_supplementals
    fi

    acquire_lock
    check_wrapper_collision
    install_ecc_bundle "$ECC_ARCHIVE"

    OSS_ROOT=""
    PDK_ROOT=""
    if [ "$WITH_TOOLCHAIN" = 1 ]; then
        OSS_ROOT="$(install_oss_cad "$OSS_ARCHIVE")"
        PDK_ROOT="$(install_pdk "$PDK_ARCHIVE")"
        install_sizer "$SIZER_ARCHIVE"
        if [ -z "$OSS_ROOT" ] || [ -z "$PDK_ROOT" ]; then
            err "toolchain installation failed"
        fi
    elif select_existing_toolchain; then
        say "existing managed toolchain will be exported by the wrapper"
    else
        say "ECC was installed without the managed toolchain"
    fi

    write_wrapper "$OSS_ROOT" "$PDK_ROOT"
    write_receipt
    say "installed ECC ${ECC_VERSION} to ${DATA_ROOT}/${ECC_TAG}"
    print_path_guidance
}

main "$@"
